    <AssemblyName>SharpCompress</AssemblyName>
    <RootNamespace>SharpCompress</RootNamespace>
    <Version>0.48.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
